# ---- Required: secrets -------------------------------------------------------
ADMIN_SECRET=
ANTHROPIC_API_KEY=

# ---- Required: GCP -----------------------------------------------------------
# Audio backend is GCS-only (no local fallback).
# For local dev, point to the stage bucket so you get pre-cached audio.
GOOGLE_CLOUD_PROJECT=knotmem26
AUDIO_BUCKET=verbboard-audio-stage

# ---- Environment -------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO

# ---- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080

# ---- Edition (free vs Plus) --------------------------------------------------
# Same image, config-only difference. Free defaults reproduce today's behavior
# with zero vars set; only override on a Plus deployment.
# EDITION=free
# STUDY_LANGUAGES=en,ru,he,es
# APP_NAME=VerbBoard
# APP_SHORT_NAME=VerbBoard
# ANDROID_PACKAGE_NAME=com.verbboard.app
# ANDROID_CERT_FINGERPRINTS=
# ON_DEMAND_EXAMPLES_ENABLED=false
# Kill switch (not edition-gated), defaults on. Set false to disable the
# form-row jump-to-example button without a redeploy.
# Currently OFF in stage/prod (2026-07-28) pending the real fix -- see PRODUCT_BACKLOG.md.
# JUMP_TO_EXAMPLE_ENABLED=true

# ---- Practice loop ----------------------------------------------------------
# Display threshold: below this badge count show individual medals,
# at or above switch to compact N× grouped view.
# BADGE_COMPACT_THRESHOLD=20

# ---- Verbs page -------------------------------------------------------------
# Verbs pre-loaded from Firestore on page load (sorted by rank; 0 = unlimited).
# Desktop: must be greater than VERBS_DISPLAY_BATCH (show-more button pages through
#   the pre-loaded set, then fetches additional Firestore batches beyond this limit).
# Mobile: all VERBS_PAGE_LIMIT verbs are shown at once (no display-batch cap);
#   if the total verb count exceeds this limit, the "Show more" button fetches
#   additional Firestore batches on demand, same as desktop.
# VERBS_PAGE_LIMIT=300
# Desktop only: how many pre-loaded verbs to reveal per "Show more" click.
# Ignored on mobile (all pre-loaded verbs are shown immediately).
# VERBS_DISPLAY_BATCH=20

# ---- Firestore collection overrides (optional, defaults shown) ---------------
# VERBS_COLLECTION=verbs
# VERB_CANDIDATES_COLLECTION=verb_candidates
# VERB_SIGNALS_COLLECTION=demand_signal
# VERB_SIGNAL_LABELS_COLLECTION=demand_signal_labels

# ---- Analytics (optional) -----------------------------------------------------
# Comma-separated emails to drop from /admin/feedback usage counts (own/test accounts).
# ANALYTICS_EXCLUDED_EMAILS=
